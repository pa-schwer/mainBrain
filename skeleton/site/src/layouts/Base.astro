---
/**
 * Page shell: document, head, and the global stylesheet.
 *
 * No state and no business logic. This repo renders markup; anything that
 * needs to remember something belongs in the app, and anything that
 * decides something belongs in the functions repo.
 */
import "../styles/global.css";
import { absoluteUrl } from "../lib/url";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site ? absoluteUrl(Astro.site.href, Astro.url.pathname) : undefined;
---

<!doctype html>
<html lang="{{HTML_LANG}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <!-- No favicon yet: the mark comes with the design tokens. The empty
         data URL stops the browser requesting /favicon.ico and logging a
         404 on every page. -->
    <link rel="icon" href="data:," />
    <!-- Before first paint: opt in to scroll-triggered motion (global.css). -->
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.dataset.motion = "";
    </script>
  </head>
  <body class="antialiased">
    <slot />
    <script>
      // Plays each [data-reveal] block once, as its top edge crosses the
      // lower quarter of the screen, so the entrance happens in view. A
      // ratio threshold would never fire for a block taller than the
      // viewport on a phone.
      const blocks = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (document.documentElement.hasAttribute("data-motion") && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute("data-play", "");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -25% 0px" },
        );
        blocks.forEach((block) => observer.observe(block));
      } else {
        blocks.forEach((block) => block.setAttribute("data-play", ""));
      }
    </script>
  </body>
</html>
