---
import Base from "../layouts/Base.astro";
import { SITE_TITLE } from "../config";
---

<Base title={`Page not found | ${SITE_TITLE}`} description="This page does not exist.">
  <main class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="text-2xl font-semibold tracking-tight">This page does not exist.</h1>
    <p class="mt-4"><a href="/" class="underline underline-offset-4">Go to the home page</a></p>
  </main>
</Base>
