// Cloudflare Workers config. This Worker has no script: it serves the
// static build in dist/ through Workers Static Assets. Cloudflare marks the
// older Pages flow as legacy, so new projects go here.
//
// Workers Builds runs `npm run build` and then `npx wrangler deploy` on each
// push. The production branch is `prod`; every other branch gets a preview
// deployment, which is how `main` becomes staging.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT}}-site",
  "compatibility_date": "2026-09-01",
  // A branch other than `prod` may build with `npx wrangler preview`, which
  // refuses a config without this block; empty is enough.
  "previews": {},
  "assets": {
    "directory": "./dist",
    // A path that matches nothing serves the 404 page Astro builds, with a
    // 404 status. The site has no client-side router to hand it to.
    "not_found_handling": "404-page"
  }
}
