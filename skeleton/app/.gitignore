# .env.staging and .env.production carry the Firebase web config, which is
# public by construction and committed. Anything else named .env is not.
.env
.env.*
!.env.staging
!.env.production

# unlazy: the ledger and hook state of one session. They carry absolute
# paths, so they never reach a commit; the count goes in the PR body.
/GATES.md
.unlazy/
.unlazy-hook-state.json
*.unlazy.bak
.claude/settings.local.json
