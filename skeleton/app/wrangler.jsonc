// Cloudflare Workers config. This Worker has no script: it serves the
// static build in dist/ through Workers Static Assets.
//
// Workers Builds runs `npm run build` on each push, then `npx wrangler
// deploy` on the production branch and `npx wrangler preview` on any other.
// The production branch is `prod`, and `main` is a Preview, which is
// staging; until the first go prod creates `prod`, `main` is production
// (HANDOFF.md C1). The build picks the Firebase project from the branch;
// see scripts/build.mjs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT}}-app",
  "compatibility_date": "2026-09-01",
  // A branch other than `prod` may build with `npx wrangler preview`, which
  // refuses a config without this block; empty is enough.
  "previews": {},
  "assets": {
    "directory": "./dist",
    // A single-page app: any path that is not a file serves index.html and
    // the client router takes over.
    "not_found_handling": "single-page-application"
  }
}
