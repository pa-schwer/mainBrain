{
  "name": "{{PROJECT}}-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "{{TITLE}} dashboard. Vite + React, served by a Cloudflare Worker at {{APP_DOMAIN}}.",
  "scripts": {
    "dev": "vite --mode staging",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "firebase": "^11.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "wrangler": "^4.0.0"
  }
}
