# Firebase web config for {{FIREBASE_STAGING}}. Public by construction: these
# values ship inside the bundle, and the security boundary is
# firestore.rules in the functions repo. Selected by scripts/build.mjs on
# every branch except prod, and by `npm run dev` locally.
#
# Blank until HANDOFF.md step F5: Firebase console -> project settings ->
# Your apps -> Web app -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN={{FIREBASE_STAGING}}.firebaseapp.com
VITE_FIREBASE_PROJECT_ID={{FIREBASE_STAGING}}
VITE_FIREBASE_APP_ID=
